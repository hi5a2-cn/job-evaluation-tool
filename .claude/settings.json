{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__Claude_Browser__.*|mcp__claude-in-chrome__.*|mcp__computer-use__.*|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/boss-guard.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/serve-restart-guard.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
