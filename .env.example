# Jet 配置示例
# 注意：真实 .env 应当放置在数据目录内（默认 ~/Library/Application Support/Jet/.env），
# 绝不要将含有真实 API Key 的 .env 提交到代码仓库。
# 下面每一项都可以不写，不写就用等号右边的默认值。
# 注释可以单独成行，也可以写在值后面（值和 # 之间要有空格）；值留空等于没写，用默认值。

JET_LLM_BASE_URL=https://api.deepseek.com
JET_LLM_MODEL=deepseek-flash
# API Key 一般在设置页填写（保存在数据目录的 llm_api_key 文件里，优先于这里）
JET_LLM_API_KEY=
JET_PORT=47615

# 每日上限：岗位判断（含复核）
JET_DAILY_LLM_LIMIT=150
# 每日上限：沟通建议生成
JET_DAILY_ASSIST_LIMIT=50
# 列表页预判的每日上限在设置页里改（默认 20 页）；简历画像生成固定每天最多 10 次

# 提示词版本：一般不要设置，留空就用当前默认版本（定义在 src/jet/llm/versions.py）。
# 写了版本表里没有的版本号时，jet serve 会启动失败并列出可用版本。
# JET_PROMPT_VERSION=
JET_JUDGE_ENGINE=deepseek-flash:no-think
# 同时进行的判断数
JET_JUDGE_CONCURRENCY=3
# 单次请求超时（秒）：关闭思考 / 开启思考
JET_LLM_TIMEOUT_S=20.0
JET_LLM_THINKING_TIMEOUT_S=60.0

# 复核：B（关闭思考）给出适合投递 / 可以一试时，用开启思考的模型再判一次（只降档，计入每日额度）
JET_REVIEW_ENABLED=1
JET_REVIEW_ENGINE=deepseek-flash:think

# 单价（元 / 百万 token），只用来估算每次调用的费用（jet stats 里显示），不影响判断
JET_PRICE_INPUT_PER_M=2.0
JET_PRICE_CACHED_PER_M=0.04
JET_PRICE_OUTPUT_PER_M=8.0

# 评测（jet eval）
JET_EVAL_MAX_CALLS=300

# 数据目录只能用环境变量指定（不能写在这个文件里）：JET_DATA_DIR=/path/to/data
